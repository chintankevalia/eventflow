# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev uses the embedded server (npm run db:start) on port 5433.
DATABASE_URL="postgresql://eventflow:CHANGE_ME@localhost:5433/eventflow"

# ── Application ───────────────────────────────────────────────────────────────
# Public base URL of the portal — used in email links. No trailing slash.
APP_URL="http://localhost:3000"

# File storage root (absolute path). Defaults to ./storage if unset.
# STORAGE_DIR="/var/eventflow/storage"

# Vercel Blob: when set, uploads are stored privately in Vercel Blob instead of on disk.
# Vercel adds this automatically when a Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=""

# ── Mail ──────────────────────────────────────────────────────────────────────
# Transport: "outbox" writes emails to .data/outbox (view at /dev/outbox); "smtp" sends them.
MAIL_TRANSPORT="outbox"
MAIL_FROM="EventFlow <eventflow@motadata.com>"
# Microsoft 365 SMTP relay (production):
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ── HubSpot integration (Phase 8) ────────────────────────────────────────────
# Exactly 32 characters (or more). Used to AES-256-GCM encrypt the HubSpot token at rest.
# Generate: openssl rand -base64 32 | tr -d '=' | cut -c1-32
HUBSPOT_ENCRYPT_KEY=""

# ── Development only — never set in production ────────────────────────────────
DEV_SEED_PASSWORD=""

# Integration tests use a separate database holding only test data.
TEST_DATABASE_URL="postgresql://eventflow:CHANGE_ME@localhost:5433/eventflow_test"
