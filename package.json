{
  "name": "eventflow",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:start": "tsx --env-file=.env scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "postinstall": "prisma generate",
    "user:create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "db:seed-dev": "tsx --env-file=.env scripts/seed-dev-users.ts",
    "db:seed-demo": "tsx --env-file=.env scripts/seed-demo-data.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "config:seed": "tsx --env-file=.env scripts/seed-config.ts",
    "config:seed-dashboards": "tsx --env-file=.env scripts/seed-stock-dashboards.ts",
    "regions:remap": "tsx --env-file=.env scripts/remap-regions.ts",
    "import:channel-sheet": "tsx --env-file=.env scripts/import-channel-sheet.ts",
    "reimport:master-sheet": "tsx --env-file=.env scripts/reimport-master-sheet.ts",
    "approvals:remind": "tsx --env-file=.env scripts/run-reminders.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.56.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "EventFlow — Event Request & Approval Management (Motadata)",
  "overrides": {
    "postcss": "^8.5.30",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=20.18"
  }
}
